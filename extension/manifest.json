{
  "manifest_version": 3,
  "name": "2pa.ms El País Redirect",
  "version": "0.2.0",
  "description": "Open El País links entered through 2pa.ms as top-level pages in this browser.",
  "minimum_chrome_version": "109",
  "permissions": ["declarativeNetRequestWithHostAccess"],
  "host_permissions": [
    "https://2pa.ms/*",
    "https://elpais.com/*",
    "https://www.elpais.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "elpais_redirect", "enabled": true, "path": "rules.json" }
    ]
  }
}
