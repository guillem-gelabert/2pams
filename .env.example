# Server Configuration
PORT=3000
NODE_ENV=development

# Add your custom environment variables below
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# JWT_SECRET=your-secret-key
# API_KEY=your-api-key

# Optional: same security headers as Caddy when not behind Caddy (e.g. local prod test)
# APPLY_SECURITY_HEADERS=1

# Railway two-service deployment: shell at 2pa.ms, content at a separate
# *.up.railway.app domain. Leave ROLE unset only for legacy local/self-host mode.
# ROLE=shell
# CONTENT_ORIGIN=https://your-content-service.up.railway.app
# On the content service instead: ROLE=content

# Content service only: comma-separated upstream hosts eligible for a browser
# fallback after a recognized DataDome challenge. Empty disables the fallback.
# BROWSER_FALLBACK_HOSTS=example.com

# Content service only: comma-separated HTTPS hosts opened in a short-lived
# interactive Railway browser. Leave empty to keep the ordinary proxy path.
# LIVE_BROWSER_HOSTS=example.com

# Optional: baked into proxied pages; Railway/Docker can set at build
# DEPLOYMENT_TIMESTAMP=2026-01-01T00:00:00.000Z
